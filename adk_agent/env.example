# ─────────────────────────────────────────────────────────────
#  ADK Agent — Environment Configuration
#  Copy this file to .env and fill in your values
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────


# ── Anthropic ─────────────────────────────────────────────────
# Your API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude model to use via LiteLLM
# Options:
#   claude-sonnet-4-6   → best balance of speed + intelligence (recommended)
#   claude-opus-4-6     → most powerful, slower and more expensive
#   claude-haiku-4-5-20251001    → fastest, cheapest, for light tasks
CLAUDE_MODEL=claude-sonnet-4-6


# ── ADK Server ────────────────────────────────────────────────
# Port this ADK web server listens on
# !! Must NOT be 8000 — that is already used by the FastAPI backend
# Update backend/.env → ADK_BASE_URL=http://localhost:8001
ADK_PORT=8001

# Name of the root agent (must match what's in agent.py)
# Also set in backend/.env → ADK_AGENT_NAME=root_agent
ADK_AGENT_NAME=root_agent


# ── LiteLLM (optional) ────────────────────────────────────────
# Only needed if routing through a LiteLLM proxy instead of direct Anthropic API
# Leave blank to use the Anthropic API directly (recommended)
LITELLM_BASE_URL=
LITELLM_API_KEY=


# ── Agent Behaviour ───────────────────────────────────────────
# Max tokens the agent can generate per response
MAX_OUTPUT_TOKENS=4096

# Temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.7
